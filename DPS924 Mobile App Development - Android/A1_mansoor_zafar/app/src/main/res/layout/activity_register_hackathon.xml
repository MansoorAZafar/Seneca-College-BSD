<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterHackathonActivity">

    <TextView
        android:id="@+id/hackathonNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:background="#000000"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:text="@string/placeholder_hackathon_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Team Size Input -->
    <TextView
        android:id="@+id/teamSizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team Size"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/hackathonNameTextView"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/teamSizeEditText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Enter team size"
        android:inputType="number"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/teamSizeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Team Names Input -->
    <TextView
        android:id="@+id/teamNamesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team Names"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/teamSizeEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/teamNamesEditText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Enter team names (comma-separated)"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/teamNamesLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Project Idea Input -->
    <TextView
        android:id="@+id/projectIdeaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Project Idea"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/teamNamesEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/projectIdeaEditText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Describe your project idea"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/projectIdeaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Terms and Conditions Switch -->
    <TextView
        android:id="@+id/termsConditionsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accept Terms and Conditions"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/projectIdeaEditText"
        app:layout_constraintStart_toStartOf="parent" />

    <Switch
        android:id="@+id/termsSwitch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/termsConditionsLabel"
        app:layout_constraintStart_toStartOf="@id/termsConditionsLabel" />

    <!-- Back Button -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/termsSwitch"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/termsSwitch"
        app:layout_constraintStart_toStartOf="@id/termsSwitch" />

    <!-- TextView for error messages -->
    <TextView
        android:id="@+id/errorTextView"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="@id/termsSwitch"
        app:layout_constraintStart_toEndOf="@id/termsSwitch"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="" /> <!-- This can remain empty for now -->

</androidx.constraintlayout.widget.ConstraintLayout>