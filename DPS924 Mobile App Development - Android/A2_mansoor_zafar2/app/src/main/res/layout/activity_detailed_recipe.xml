<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/recipe_detailed_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Item!"
            android:textSize="50sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="15dp"
            />

        <ImageView
            android:id="@+id/recipe_detailed_img"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/baseline_cake_24"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: "
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@+id/recipe_detailed_img"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="5dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_ingredients_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ingredients"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_duration"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_ingredients_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="steps"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_ingredients_label"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_instructions_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="instructions"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_ingredients_text"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            />

        <TextView
            android:id="@+id/recipe_detailed_instructions_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="steps"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_instructions_label"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="30dp"
            android:paddingBottom="30dp"
            />


        <!-- Back Button -->
        <Button
            android:id="@+id/recipe_detailed_backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_instructions_text"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/recipe_detailed_submitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initiate\nTimer"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/recipe_detailed_instructions_text"
            app:layout_constraintStart_toStartOf="parent"

            />



    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>